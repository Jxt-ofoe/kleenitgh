# ==============================================================================
# KLEENIT GHANA - TURSO DATABASE & ADMIN DASHBOARD ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your Turso database credentials and admin credentials.
# 3. Never commit .env into source control!
# ==============================================================================

# Turso Database Configuration
# Obtain your Turso database URL by running:
#   turso db create kleenit-db
#   turso db show kleenit-db --url
# Example: libsql://kleenit-db-yourusername.turso.io
TURSO_DATABASE_URL="libsql://kleenit-db-yourusername.turso.io"

# Turso Authentication Token
# Obtain your token by running:
#   turso db tokens create kleenit-db
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# Secure JWT Authentication Secret
# A random secret string used to sign administrator authentication tokens.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters"

# Optional: Administrator Credentials in Environment Variables
# If provided, the system will automatically ensure this admin exists in Turso.
# You can also use this to reset your admin password directly from Vercel.
ADMIN_USERNAME="admin@kleenitgh.com"
ADMIN_PASSWORD="YourStrongPassword2026!"
ADMIN_NAME="Kleenit Administrator"

# WhatsApp Business Configuration
# Kleenit Ghana WhatsApp Business phone number in international format without '+'
WHATSAPP_PHONE_NUMBER="233544026418"
